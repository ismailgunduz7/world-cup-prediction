{
  "name": "world-cup-prediction",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "create-user": "npm run create-user -w server",
    "seed-test-data": "npm run seed-test-data -w server --",
    "reset-tournament": "npm run reset-tournament -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
