# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DATABASE_PASSWORD=your-database-password

# JWT secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Refresh token TTL (days): remember-me vs short session
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_DAYS=1

# Refresh-token cookie SameSite policy: Lax (default, same-origin / proxy
# deployments) or None (client and API on different domains; forces Secure).
REFRESH_COOKIE_SAMESITE=Lax

# Server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Admin panel secret path segment (no leading slash)
ADMIN_PATH=internal-console-7k9m2

# Optional: football-data.org API key for match sync
FOOTBALL_DATA_API_KEY=
